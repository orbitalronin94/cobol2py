       IDENTIFICATION DIVISION.
       PROGRAM-ID. LABERINTO-COBOL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-CONTROL-VARS.
          05 WS-STEP PIC 9(2) VALUE 01.
          05 WS-SWITCH PIC X VALUE 'N'.
          05 WS-ACCUMULATOR PIC S9(9) COMP VALUE 100.
       01 WS-TRICKY-DATA.
          05 WS-RAW-INPUT PIC X(10) VALUE "0012300456".
          05 WS-VIEW-1 REDEFINES WS-RAW-INPUT.
             10 WS-A PIC 9(5).
             10 WS-B PIC 9(5).
          05 WS-VIEW-2 REDEFINES WS-RAW-INPUT.
             10 WS-PREFIX PIC X(2).
             10 WS-PAYLOAD PIC X(8).
       PROCEDURE DIVISION.
       MAIN-LOGIC.
           DISPLAY "INICIO DEL LABERINTO COBOL".
           ALTER PUNTO-X TO PROCEED TO PUNTO-Y.
           GO TO PUNTO-A.
       PUNTO-A.
           ADD 10 TO WS-ACCUMULATOR.
       PUNTO-X.
           GO TO PUNTO-Z.
       PUNTO-Y.
           MULTIPLY 2 BY WS-ACCUMULATOR.
           GO TO PUNTO-B.
       PUNTO-Z.
           SUBTRACT 5 FROM WS-ACCUMULATOR.
           GO TO PUNTO-B.
       PUNTO-B.
           GO TO P-VAL-1 P-VAL-2 P-VAL-3 DEPENDING ON WS-STEP.
           GO TO FINAL-ROUTINE.
       P-VAL-1.
           MOVE 2 TO WS-STEP.
           ALTER PUNTO-X TO PROCEED TO PUNTO-Z.
           GO TO PUNTO-A.
       P-VAL-2.
           MOVE 3 TO WS-STEP.
           MOVE "9999911111" TO WS-RAW-INPUT.
           ADD WS-A TO WS-B GIVING WS-ACCUMULATOR.
           GO TO MAIN-LOGIC.
       P-VAL-3.
           MOVE 99 TO WS-STEP.
           GO TO FINAL-ROUTINE.
       FINAL-ROUTINE.
           DISPLAY "RESULTADO FINAL ACUMULADOR: " WS-ACCUMULATOR.
           STOP RUN.
